clc;
clear;

%% x1: stair-step signal
x1 = [ ...
    zeros(1,20), ...
    ones(1,30), ...
    2*ones(1,30), ...
    3*ones(1,30), ...
    1.5*ones(1,30), ...
    zeros(1,20)];

%% xtv: simulated scan line from an image
xtv = [ ...
    30*ones(1,30), ...
    120*ones(1,40), ...
    220*ones(1,30), ...
    80*ones(1,40), ...
    180*ones(1,30)];

%% x2: speech-like waveform sampled at 8000 Hz
fs = 8000;

t = 0:1/fs:1;

x2 = ...
    sin(2*pi*180*t) + ...
    0.5*sin(2*pi*350*t) + ...
    0.2*sin(2*pi*700*t);

%% h1: FIR filter coefficients
h1 = 1/5 * ones(1,5);

%% h2: second FIR filter
h2 = [1 -0.9];

%% Save everything
save('labdat.mat','x1','xtv','x2','h1','h2');

disp('labdat.mat created.')